{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "src/assets/styles/**",
      "use": "@vercel/static"
    },
    {
      "src": "src/css/**",
      "use": "@vercel/static"
    },
    {
      "src": "src/js/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/assets/styles/(.*)", "dest": "/src/assets/styles/$1" },
    { "src": "/css/(.*)", "dest": "/src/css/$1" },
    { "src": "/js/(.*)", "dest": "/src/js/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
